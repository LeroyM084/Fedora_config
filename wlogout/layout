{
        "label" : "logout",
        "action" : "pkill -u $USER",
        "text" : "Déconnexion",
        "keybind" : "e"
},
{
        "label" : "shutdown",
        "action" : "loginctl poweroff",
        "text" : "Éteindre",
        "keybind" : "s"
},
{
        "label" : "reboot",
        "action" : "loginctl reboot",
        "text" : "Redémarrer",
        "keybind" : "r"
}